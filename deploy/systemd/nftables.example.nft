#
# EXAMPLE host firewall for one cosigner (docs/bare-metal.md, "Firewall"). It does what the Helm
# chart's NetworkPolicy does in a cluster. Nothing installs this file: merge the rules into the
# firewall the host already has. The addresses are documentation addresses; put in your own.
#
#   gRPC 9101     from the two other cosigners and from the Canton participant (the driver)
#   metrics 9200  from the Prometheus server only
#   out           9101 to the two other cosigners, DNS
#
# The table only looks at the cosigner's ports and at what the cosigner's user sends; SSH and
# everything else on the host stay with your own rules.
table inet rutli_cosigner {
  set peers {
    type ipv4_addr
    elements = { 192.0.2.12, 192.0.2.13 }
  }
  set clients {
    type ipv4_addr
    elements = { 192.0.2.20 }
  }
  set scrapers {
    type ipv4_addr
    elements = { 192.0.2.30 }
  }

  chain input {
    type filter hook input priority filter; policy accept;
    iifname "lo" accept
    ct state established,related accept
    tcp dport 9101 ip saddr @peers accept
    tcp dport 9101 ip saddr @clients accept
    tcp dport 9200 ip saddr @scrapers accept
    tcp dport { 9101, 9200 } drop
  }

  chain output {
    type filter hook output priority filter; policy accept;
    oifname "lo" accept
    ct state established,related accept
    meta skuid "rutli" tcp dport 9101 ip daddr @peers accept
    meta skuid "rutli" meta l4proto { tcp, udp } th dport 53 accept
    meta skuid "rutli" drop
  }
}
