{
  "identifier": 1,
  "listen": "0.0.0.0:9101",
  "threshold": 2,
  "data_dir": "/data",
  "peers": [
    {
      "identifier": 1,
      "endpoint": "https://cosigner1:9101"
    },
    {
      "identifier": 2,
      "endpoint": "https://cosigner2:9102"
    },
    {
      "identifier": 3,
      "endpoint": "https://cosigner3:9103"
    }
  ],
  "tls": {
    "ca_cert": "/certs/ca.crt",
    "cert": "/certs/cosigner1.crt",
    "key": "/certs/cosigner1.key",
    "domain": "rutli-cosigner"
  },
  "share_seal": {
    "secret_env": "RUTLI_SEAL_SECRET"
  },
  "hosted_keys": {
    "enabled": true,
    "write_quorum": 2,
    "anti_entropy_interval_secs": 300,
    "decrypt_rate_limit_per_min": 6000
  },
  "signer_allowlist": [
    "driver"
  ],
  "metrics_listen": "0.0.0.0:9200",
  "peer_allowlist": [
    "cosigner1",
    "cosigner2",
    "cosigner3"
  ],
  "operator_allowlist": [
    "operator"
  ]
}
