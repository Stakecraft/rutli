# The image of the load tests (scripts/perf-load.sh): the cosigner built exactly as frost/Dockerfile
# builds it, plus the load generator. Never published, never a release artifact.
#
# One image instead of two so that the workspace is compiled once, and so that a cluster under test
# and its load generator are always the same commit. The two FROM lines must be those of
# frost/Dockerfile (scripts/perf-load.sh compares them before it builds).

# rust:1.100.0-slim
FROM rust:1.100.0-slim@sha256:6f14b2b4b278ec0d50aa1d69541c304ce0f95e0f6268487aa9924af1c2e9aebe AS build
WORKDIR /src
COPY . .
ARG CARGO_BUILD_JOBS=4
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
# The same command as frost/Dockerfile, on its own: built together with the load generator, cargo
# could give the daemon's dependencies features that only the generator asks for.
RUN cargo build --release --locked -p rutli-cosigner --bin rutli-cosigner
RUN cargo build --release --locked -p rutli-loadgen --bin rutli-loadgen

# debian:stable-slim (trixie when pinned)
FROM debian:stable-slim@sha256:fbfb4059d2127120aa05b6e6064523d2102552f0cf0026ddf0701c12f1f8f3e0
RUN useradd -r -u 10001 rutli && mkdir /data && chown rutli /data
COPY --from=build /src/target/release/rutli-cosigner /usr/local/bin/rutli-cosigner
COPY --from=build /src/target/release/rutli-loadgen /usr/local/bin/rutli-loadgen
USER rutli
VOLUME ["/data"]
ENTRYPOINT ["rutli-cosigner"]
