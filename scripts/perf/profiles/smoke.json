  "baseline": {
    "sign_keys": 2,
    "ecdh_keys": 1,
    "phases": [
      { "name": "average", "sign_per_sec": 1, "ecdh_per_sec": 1, "secs": 15 },
      { "name": "burst", "sign_per_sec": 4, "secs": 5 }
    ]
  },
  "step_secs": 30,
  "factors": [1, 3],
  "keys": { "counts": [1, 10], "sign_per_sec": 5, "secs": 20 },
  "connect": { "clients": [20, 50] },
  "diagnose": { "sign_per_sec": 2, "factors": [1, 3, 10], "step_secs": 20, "key_counts": [2, 4] },
  "max_rss_mib": 256
}
